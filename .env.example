NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co          # same value as SUPABASE_URL below, safe to expose — needed for history/downloads thumbnails
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key   # server only, never expose
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=   # run: node -e "console.log(require('bcryptjs').hashSync('YourStrongPassword',12))"
SESSION_SECRET=long-random-string   # run: openssl rand -hex 32
